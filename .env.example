# CJdropshipping developer API key (CJ app store -> "API" app -> install ->
# cjdropshipping.com/my.html#/authorize/API -> Add API -> Type "API Key")
# Confirmed working with just this key, no email/password needed.
CJ_API_KEY=your_api_key_here

# Since you're selling online to anywhere, list every country you expect
# customers from (comma-separated ISO codes). The scan checks shipping cost
# to EACH of these and ranks by the worst-case (lowest) margin across all of
# them, so a product only wins if it's still profitable everywhere you sell.
DESTINATION_COUNTRIES=IN,US,GB,AU,CA,DE

# A product's name must contain at least one of these (case-insensitive) to
# pass the cuteness filter - this is what keeps results on the Mirthovia
# aesthetic even though the category keyword search itself is broader.
CUTENESS_KEYWORDS=cute,kawaii,pastel,mini,chibi,adorable,korean,cartoon,bear,cat,rabbit,bunny,strawberry,star,heart,rainbow,flower,smiley,plush,aesthetic,pink,candy

# Google Gemini API key, for generating Instagram captions per product.
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Your WED2C shop's id, from CJ's GET /shop/getShops - used by the "Add to
# Store" button to push a product directly via POST /store/product/saveProduct.
# Confirmed working against a real account - the product lands as a real,
# live listing on your store immediately, not a draft.
WED2C_SHOP_ID=your_wed2c_shop_id_here

# MongoDB Atlas connection string (free cluster at mongodb.com/cloud/atlas) -
# all app data (posted status, manually-added products, fetch history, the
# product cache, last scan result) lives here instead of in data/*.json.
# Paste it exactly as Atlas gives it to you (Connect -> Drivers) - no need to
# add a database name yourself, the app always uses "mirthovia", e.g.:
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Approximate USD->INR rate for displaying prices in rupees alongside dollars.
# This is NOT a live rate - update it yourself occasionally (search "usd to
# inr") since it only needs to be roughly right for margin estimates, not
# exact for invoicing.
USD_TO_INR=88.0

# The scan's default categories/keywords/seasons live in
# scan_categories.json, not here - that's a list of objects, which
# doesn't fit cleanly on one .env line. Edit that file directly to change
# the defaults, or use the dashboard's "customize this scan" option to
# override them for a single run without touching the file.

# Floor price = cost x this multiplier (1.5 = a 50% markup on cost). This is
# explicitly NOT a market price suggestion, just a "never price below this"
# floor - always verify against a real comparable price before listing.
PRICE_MARKUP_MULTIPLIER=1.5

# A product with this many other CJ sellers or more is excluded before it's
# even scored - past this, it's not "proven demand," it's "impossible to
# differentiate from." Per-category overrides (clothing/jewelry categories
# that need a higher cutoff to get any results at all) live in
# scan_categories.json instead of here.
SCAN_SATURATED_THRESHOLD=300

# How many top-ranked products to keep per category, and overall across all
# categories combined, after each scan.
SCAN_TOP_PER_CATEGORY=10
SCAN_TOP_OVERALL=30
