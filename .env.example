# CJdropshipping developer API key (CJ app store -> "API" app -> install ->
# cjdropshipping.com/my.html#/authorize/API -> Add API -> Type "API Key")
# Confirmed working with just this key, no email/password needed.
CJ_API_KEY=your_api_key_here

# Since you're selling online to anywhere, list every country you expect
# customers from (comma-separated ISO codes). The scan checks shipping cost
# to EACH of these and ranks by the worst-case (lowest) margin across all of
# them, so a product only wins if it's still profitable everywhere you sell.
DESTINATION_COUNTRIES=IN,US,GB,AU,CA,DE

# A product's name must contain at least one of these (case-insensitive) to
# pass the cuteness filter - this is what keeps results on the Mirthovia
# aesthetic even though the category keyword search itself is broader.
CUTENESS_KEYWORDS=cute,kawaii,pastel,mini,chibi,adorable,korean,cartoon,bear,cat,rabbit,bunny,strawberry,star,heart,rainbow,flower,smiley,plush,aesthetic,pink,candy

# Fallback markup used only when a category's realistic target retail price
# (set in app/picker.py's CATEGORIES list) is already below landed cost.
MARKUP_MULTIPLIER=3.5

# Google Gemini API key, for generating Instagram captions per product.
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
